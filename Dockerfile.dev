# syntax=docker/dockerfile:1
# Dev image: runs the Vite dev server with HMR. Source is bind-mounted at /app
# from the host, and an anonymous volume keeps a container-native node_modules.

FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Source (including node_modules override via anonymous volume) is mounted
# at runtime by the compose override.
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]